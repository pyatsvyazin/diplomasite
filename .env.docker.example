# Скопируйте в корень проекта:  cp .env.docker.example .env
# Затем отредактируйте значения под свой сервер.

# --- Сайт (один домен: nginx отдаёт и фронт, и /api) ---
APP_URL=http://localhost
FRONTEND_URL=http://localhost
HTTP_PORT=80

# Публичные URL для сборки Next (должны совпадать с тем, как открываете сайт в браузере)
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost

# --- Laravel ---
APP_NAME="Юридический щит"
APP_ENV=production
APP_DEBUG=false
# Сгенерируйте: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:ЗАМЕНИТЕ_НА_СВОЙ_КЛЮЧ

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=diploma
DB_USERNAME=diploma
DB_PASSWORD=change_me_db

MYSQL_ROOT_PASSWORD=change_me_root

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local
BROADCAST_DRIVER=pusher

# CORS (если фронт на другом домене — укажите его; при одном домене достаточно APP_URL)
CORS_ALLOWED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS_PATTERNS=

# --- Почта (пример: Yandex) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
NOTIFICATIONS_MAIL_ENABLED=true

# --- WebSocket (Soketi) — для браузера укажите хост сайта и порт nginx (80/443) ---
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

NEXT_PUBLIC_PUSHER_APP_KEY=app-key
NEXT_PUBLIC_PUSHER_HOST=localhost
NEXT_PUBLIC_PUSHER_PORT=80
NEXT_PUBLIC_PUSHER_SCHEME=http
NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1

SOKETI_DEBUG=0
